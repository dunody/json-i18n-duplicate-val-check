{
  "name": "json-i18n-val-check",
  "displayName": "JSON - Duplicate Val Check",
  "description": "A JSON linter extension that helps to find duplicate object values of your JSON files",
  "version": "1.0.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/LeonardoPizzoquero/jason-lint"
  },
  "engines": {
    "vscode": "^1.72.0"
  },
  "icon": "images/icon.png",
  "categories": [
    "Linters"
  ],
  "activationEvents": [
    "onCommand:json-i18n-val-check.jsonI18n",
    "onLanguage:json"
  ],
  "main": "./out/extension.js",
  "publisher": "dyPrivateExt",
  "author": {
    "name": "LeoPizzoquero"
  },
  "contributors": [
    {
      "name": "Dun Yi",
      "email": "dunody@gmail.com"
    }
  ],
  "contributes": {
    "commands": [
      {
        "command": "json-i18n-val-check.jsonI18n",
        "title": "JSON i18n: Check JSON Duplicate Value"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTests.js"
  },
  "devDependencies": {
    "@types/glob": "^8.0.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "16.x",
    "@types/vscode": "^1.72.0",
    "@typescript-eslint/eslint-plugin": "^5.38.1",
    "@typescript-eslint/parser": "^5.38.1",
    "@vscode/test-electron": "^2.1.5",
    "eslint": "^8.24.0",
    "glob": "^8.0.3",
    "mocha": "^10.0.0",
    "typescript": "^4.8.4"
  },
  "dependencies": {
    "@vscode/vsce": "^3.7.1",
    "yarn": "^1.22.22"
  }
}